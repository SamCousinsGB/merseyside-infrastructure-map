__pycache__/
*.pyc
.DS_Store

# Build-time only (the published map needs none of this)
node_modules/
# Large/transient LV build intermediates; only tiles/lvgeo + lv_transformers.geojson
# are committed (lv_transformers.geojson IS loaded at runtime for the markers).
lv_cables.geojson
lv_cables_merged.geojson
# Same for the Cadent gas build; only tiles/gasgeo/ is committed.
gas_pipes.geojson
gas_pipes_merged.geojson
# Cadent open-data portal API key. The licence is open but the portal still
# gates downloads behind a free account, so this is a credential - never commit.
.cadent_key

# Local-only map overlays. The whole local/ directory is private: it is where
# data you may view but not republish (e.g. HP asset data) can be dropped so the
# map renders it on your machine, WITHOUT any of it reaching this public repo.
# Everything under local/ is ignored except the committed docs/example below.
local/*
!local/README.md
!local/manifest.example.json
!local/mvf.config.example.json
# Raw Overpass dumps for the extra-infrastructure build (extra_infra.geojson IS committed)
osm_pipelines.json
osm_industrial.json
*.geojson.tmp

# Build-only source inputs to final_map.py — kept on disk for rebuilds but NOT
# served by the page (the runtime loads data.json, extra_infra.geojson,
# lv_transformers.geojson and tiles/lvgeo only). ~29MB removed from the deploy.
current_power.geojson
spen_complete_revert.geojson
merseyrail_rail.json
infra_geom.json
infra_probe.json
